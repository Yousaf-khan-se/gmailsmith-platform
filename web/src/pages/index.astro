---
// Landing + download + pricing. The download button is driven by
// /releases/latest.json exactly as docs/08 §8.1 prescribes — a page that
// advertises a build which does not exist is worse than no page at all.
import Base from '../layouts/Base.astro';
import { site, pricing } from '../site';
---

<Base title={site.name} path="/">
  <section style="padding: 88px 0 64px;">
    <div class="container hero">
      <p class="eyebrow">Desktop app for Windows</p>
      <h1>Mail merge for Gmail that <em>never uploads your list</em></h1>
      <p class="lede">
        GmailSmith sends personalised campaigns through your own Gmail
        account. Your recipient list and campaign history stay on your laptop.
        When you send, Google Gmail delivers each message you chose to send.
        Account sign-in is handled by Google Firebase Authentication.
      </p>
      <div id="download" class="download-row">
        <a id="downloadBtn" class="btn btn-primary btn-lg" href="#">Download for Windows</a>
        <p id="downloadMeta" class="download-meta">Fetching the latest release…</p>
      </div>
      <p class="smarthint">
        Windows will show <strong>“Windows protected your PC”</strong> on first
        run — it’s expected for a new, unsigned installer. <a href="/install">Show me the two-click fix →</a>
      </p>
    </div>
  </section>

  <section class="band">
    <div class="container feature-grid">
      <div>
        <h3>Your data stays put</h3>
        <p>CSVs, contacts and campaign history live in your app data folder.
          When you send, the selected recipient and message go to Google Gmail
          for delivery. GmailSmith does not upload your full recipient list.</p>
      </div>
      <div>
        <h3>Two ways to connect</h3>
        <p>One-click Google sign-in or a Gmail App Password — connect your
          existing Gmail and start sending. Nothing else to set up.</p>
      </div>
      <div>
        <h3>Live campaign tracking</h3>
        <p>Progress bar, per-recipient results, retries on Gmail throttling,
          opt-out list, and a full history you can export to CSV.</p>
      </div>
    </div>
  </section>

  <section class="google-data">
    <div class="container">
      <h2 class="section-title">What Google access does GmailSmith use?</h2>
      <p>
        Google Account identity information is used to sign you in. GmailSmith
        requests the Gmail <code>gmail.send</code> permission when you
        connect Gmail, so it can send messages you prepare. It cannot read
        your inbox, drafts, or contacts. The use of information received from
        Google Workspace scopes adheres to the
        <a href="https://developers.google.com/terms/api-services-user-data-policy"
           target="_blank" rel="noreferrer">Google API Services User Data Policy</a>,
        including its Limited Use requirements. See the
        <a href="/privacy">Privacy Policy</a> for details.
      </p>
    </div>
  </section>

  <section id="pricing" style="padding: 72px 0;">
    <div class="container">
      <h2 class="section-title">Simple pricing. Your list stays on your laptop.</h2>
      <p class="section-sub">
        Use the full app on the Free plan. Paid tiers and prices shown here are
        planned; checkout is not available yet.
      </p>
      <div class="pricing-grid">
        {pricing.map((tier) => (
          <div class:list={['price-card', { featured: tier.featured }]}>
            {tier.featured && <span class="badge">Most popular</span>}
            <h3>{tier.name}</h3>
            <p class="price">{tier.price}</p>
            <p class="period">{tier.period} · {tier.devices}</p>
            {tier.yearly && (
              <p class="yearly">{tier.yearly.price} billed yearly — {tier.yearly.note}</p>
            )}
            <p class="blurb">{tier.blurb}</p>
            <ul>
              {tier.features.map((f) => <li>{f}</li>)}
            </ul>
            <a
              class:list={['btn', 'btn-block', tier.featured ? 'btn-primary' : 'btn-secondary']}
              href={
                tier.id === 'free'
                  ? '#download'
                  : (tier.checkoutMonthly || site.purchaseUrl || '#pricing')
              }
              aria-disabled={
                tier.id !== 'free' && !(tier.checkoutMonthly || site.purchaseUrl)
                  ? 'true'
                  : undefined
              }
              title={
                tier.id !== 'free' && !(tier.checkoutMonthly || site.purchaseUrl)
                  ? 'Checkout opens at launch'
                  : undefined
              }
            >
              {tier.cta}
            </a>
          </div>
        ))}
      </div>
      {!site.purchaseUrl && (
        <p class="store-note">Paid checkout opens at launch — the Free plan works today, and the paid buttons unlock with the store.</p>
      )}
    </div>
  </section>

  <section class="band faq-band">
    <div class="container" style="text-align:center;">
      <h2 class="section-title">Questions, answered</h2>
      <div class="faq">
        <details>
          <summary>Does my recipient data go to GmailSmith?</summary>
          <p>Your campaign lists and history stay on your computer. The app
            sends each message through Google Gmail to the recipient you chose.
            Google Firebase Authentication processes your account email and
            display name for sign-in. We do not upload your campaign list to
            GmailSmith or use it for analytics. See the
            <a href="/privacy">Privacy Policy</a>.</p>
        </details>
        <details>
          <summary>Do I need to configure anything?</summary>
          <p>No. Sign in with Google in one click, or use a Gmail App Password
            if you prefer — either way you’re sending your first campaign in
            minutes.</p>
        </details>
        <details>
          <summary>What about Windows SmartScreen warnings?</summary>
          <p>The installer isn’t code-signed yet, so the warning is expected. <a
            href="/install">This page</a> shows the exact two clicks to
            proceed safely.</p>
        </details>
        <details>
          <summary>Is there really a free plan?</summary>
          <p>Yes — the full app, forever, at 25 emails a day. No credit card
            and no time limit. It exists so you can feel the workflow before
            paying anything.</p>
        </details>
        <details>
          <summary>Can I buy a paid plan today?</summary>
          <p>Not yet. Paid checkout is not available; the Free plan works today.
            We will show the final paid plan, billing and cancellation details
            before checkout opens.</p>
        </details>
      </div>
    </div>
  </section>

  <style>
    .hero { text-align: center; max-width: 780px; }
    .eyebrow {
      color: var(--accent); text-transform: uppercase; letter-spacing: 0.12em;
      font-size: 12.5px; font-weight: 700; margin: 0 0 14px;
    }
    h1 {
      font-size: clamp(30px, 5.4vw, 52px); line-height: 1.12; margin: 0 0 18px;
      letter-spacing: -0.02em;
    }
    h1 em { color: var(--accent); font-style: normal; }
    .lede { color: var(--text-muted); font-size: 17px; margin: 0 auto 32px; max-width: 620px; }
    .download-row { display: flex; flex-direction: column; align-items: center; gap: 10px; }
    .btn-lg { padding: 15px 34px; font-size: 16.5px; }
    .download-meta { color: var(--text-dim); font-size: 13.5px; margin: 0; min-height: 20px; }
    .smarthint {
      margin-top: 26px; font-size: 13.5px; color: var(--text-dim);
      max-width: 560px; margin-inline: auto;
    }
    .band { background: var(--surface); border-block: 1px solid var(--border); }
    .feature-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 32px; padding: 52px 24px;
    }
    .feature-grid h3 { margin: 0 0 8px; font-size: 17px; }
    .feature-grid p { margin: 0; color: var(--text-muted); font-size: 14.5px; }
    .google-data {
      background: var(--surface2); border-block: 1px solid var(--border);
      padding: 48px 24px;
    }
    .google-data p {
      color: var(--text-muted); font-size: 15px; line-height: 1.7;
      max-width: 800px; margin: 18px auto 0; text-align: center;
    }
    .section-title { text-align: center; font-size: clamp(24px, 3.4vw, 34px); margin: 0 0 8px; }
    .section-sub {
      text-align: center; color: var(--text-muted); max-width: 560px;
      margin: 0 auto 40px;
    }
    .pricing-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 22px; align-items: stretch;
    }
    .price-card {
      background: var(--surface2); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 26px 24px; position: relative;
      display: flex; flex-direction: column;
    }
    .price-card.featured { border-color: var(--accent); }
    .badge {
      position: absolute; top: -11px; left: 20px; background: var(--accent);
      color: var(--accent-ink); font-size: 11.5px; font-weight: 700;
      padding: 3px 10px; border-radius: 99px; text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    .price-card h3 { margin: 4px 0 2px; font-size: 17px; }
    .price { font-size: 38px; font-weight: 800; margin: 6px 0 0; }
    .period { color: var(--text-dim); font-size: 13px; margin: 2px 0; }
    .yearly { color: var(--accent); font-size: 13px; font-weight: 600; margin: 2px 0 12px; }
    .blurb { color: var(--text-muted); font-size: 14px; margin: 0 0 14px; }
    .price-card ul { margin: 0 0 20px; padding-left: 18px; color: var(--text-muted); font-size: 14px; }
    .price-card li { margin-bottom: 5px; }
    .btn-block { width: 100%; margin-top: auto; }
    .store-note {
      text-align: center; color: var(--text-dim); font-size: 13px;
      margin-top: 22px;
    }
    .store-note code { color: var(--text-muted); }
    .faq { max-width: 640px; margin: 26px auto 0; text-align: left; }
    .faq details {
      border: 1px solid var(--border); border-radius: 10px;
      padding: 14px 18px; margin-bottom: 12px; background: var(--surface2);
    }
    .faq summary { cursor: pointer; font-weight: 600; font-size: 15px; }
    .faq p { color: var(--text-muted); font-size: 14.5px; margin: 10px 0 0; }
  </style>

  <script>
    // docs/08 §8.1: the manifest drives the button; never hard-code a build.
    fetch('/releases/latest.json')
      .then((r) => (r.ok ? r.json() : null))
      .then((release) => {
        const file = release && release.installer;
        if (!file) throw new Error('no installer in manifest');
        const btn = document.getElementById('downloadBtn');
        const meta = document.getElementById('downloadMeta');
        if (!btn || !meta) return;
        btn.href = '/releases/' + file.filename;
        btn.textContent = 'Download GmailSmith ' + release.version;
        meta.textContent =
          (file.bytes / 1048576).toFixed(1) +
          ' MB · SHA-256 ' + file.sha256.slice(0, 16) + '…';
      })
      .catch(() => {
        const meta = document.getElementById('downloadMeta');
        if (meta) {
          meta.textContent =
            'Release manifest unavailable — try again in a moment.';
        }
      });
  </script>
</Base>

