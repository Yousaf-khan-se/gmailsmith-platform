---
// Public landing page and pricing. Waitlist copy remains available while the
// site is in waitlist mode; the public-beta download path uses the release
// manifest when site.availability is set to 'download'.
import Base from '../layouts/Base.astro';
import { site, pricing } from '../site';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---

<Base title={site.name} path="/">
  <section style="padding: 88px 0 64px;">
    <div class="container hero">
      <p class="eyebrow">
        Desktop app for Windows{site.availability === 'waitlist' ? ' · Public release pending' : ''}
      </p>
      <h1>Mail merge in Gmail from a CSV</h1>
      <p class="lede">
        GmailSmith is a Windows desktop app for mail merge in Gmail from a CSV.
        Each row becomes a personalized message: the email column identifies
        its recipient, and other columns become merge fields. Your CSV and
        campaign history stay on your computer; messages are sent through the
        Gmail account you connect.
      </p>
      {site.availability === 'waitlist' ? (
        <div id="waitlist" class="waitlist-card">
          <h2>Get one email when GmailSmith is available</h2>
          <p class="waitlist-intro">
            Public downloads are not open yet while we finish release
            preparation. We don’t have a release date yet. Join the list for one availability
            email — no newsletter or recurring marketing.
          </p>
          {turnstileSiteKey ? (
            <form id="waitlistForm" class="waitlist-form">
              <div class="field">
                <label for="waitlistEmail">Email address</label>
                <input id="waitlistEmail" name="email" type="email" autocomplete="email"
                       maxlength="254" required placeholder="you@example.com"
                       aria-describedby="waitlistConsent waitlistStatus" />
              </div>
              <label class="consent-row" for="waitlistConsent">
                <input id="waitlistConsent" name="consent" type="checkbox" required />
                <span>Email me once when GmailSmith is available. I understand this
                  is a one-time availability notice, not a recurring mailing list.</span>
              </label>
              <div class="honeypot" aria-hidden="true">
                <label for="waitlistCompany">Company</label>
                <input id="waitlistCompany" name="company" type="text" tabindex="-1"
                       autocomplete="off" />
              </div>
              <div class="turnstile-wrap">
                <div class="cf-turnstile" data-sitekey={turnstileSiteKey}
                     data-action="waitlist" data-size="flexible" data-theme="dark"></div>
              </div>
              <button id="waitlistSubmit" class="btn btn-primary btn-lg" type="submit">
                Notify me once
              </button>
              <p id="waitlistStatus" class="waitlist-status" role="status"
                 aria-live="polite" aria-atomic="true"></p>
              <p class="privacy-note">
                We store your email with Cloudflare to send this notice. You can
                ask us to remove it at any time. See our <a href="/privacy">Privacy Policy</a>.
              </p>
              <noscript>
                <p class="waitlist-unavailable">This form needs JavaScript. You can
                  <a href={`mailto:${site.supportEmail}?subject=GmailSmith%20availability%20notice`}>email us</a>
                  to request the one-time availability notice instead.</p>
              </noscript>
            </form>
          ) : (
            <p class="waitlist-unavailable" role="status">
              Waitlist signup is being set up. Please check back soon or
              <a href={`mailto:${site.supportEmail}`}>contact support</a>.
            </p>
          )}
        </div>
      ) : (
        <>
          <div id="download" class="download-row">
            <a id="downloadBtn" class="btn btn-primary btn-lg" href="#">Download for Windows</a>
            <p id="downloadMeta" class="download-meta">Fetching the latest release…</p>
          </div>
          <p class="smarthint">
            Windows will show <strong>“Windows protected your PC”</strong> on first
            run — it’s expected for a new, unsigned installer. <a href="/install">Show me the two-click fix →</a>
          </p>
        </>
      )}
    </div>
  </section>

  <section class="band">
    <div class="container feature-grid">
      <div>
        <h3>Your data stays put</h3>
        <p>CSVs, contacts and campaign history in the desktop app live on your
          computer. When you send, only the chosen message travels through Gmail
          to its recipient. Waitlist emails are stored separately by Cloudflare
          only for the one availability notice.</p>
      </div>
      <div>
        <h3>Two ways to connect</h3>
        <p>One-click Google sign-in or a Gmail App Password — connect your
          existing Gmail and start sending. Nothing else to set up.</p>
      </div>
      <div>
        <h3>Personalize each row</h3>
        <p>Each CSV recipient row needs an email address. Other column headers
          become merge fields you can place in your subject and message body.</p>
      </div>
      <div>
        <h3>Live campaign tracking</h3>
        <p>Progress bar, per-recipient results, retries on Gmail throttling,
          opt-out list, and a full history you can export to CSV.</p>
      </div>
    </div>
  </section>

  <section class="google-data">
    <div class="container">
      <h2 class="section-title">What Google access does GmailSmith use?</h2>
      <p>
        Google Account identity information is used to sign you in. GmailSmith
        requests the Gmail <code>gmail.send</code> permission when you
        connect Gmail, so it can send messages you prepare. It cannot read
        your inbox, drafts, or contacts. The use of information received from
        Google Workspace scopes adheres to the
        <a href="https://developers.google.com/terms/api-services-user-data-policy"
           target="_blank" rel="noreferrer">Google API Services User Data Policy</a>,
        including its Limited Use requirements. See the
        <a href="/privacy">Privacy Policy</a> for details.
      </p>
    </div>
  </section>

  <section id="pricing" style="padding: 72px 0;">
    <div class="container">
      <h2 class="section-title">Simple pricing. Your list stays on your laptop.</h2>
      <p class="section-sub">
        {site.availability === 'waitlist'
          ? 'Pricing is confirmed. The Free plan will be available when public downloads open; paid plans are coming soon. Join the waitlist to receive one availability email.'
          : 'Pricing is confirmed. The Free plan is available now; paid plans are coming soon.'}
      </p>
      <div class="pricing-grid">
        {pricing.map((tier) => (
          <div class:list={['price-card', { featured: tier.featured }]}>
            {tier.featured && (
              <span class="badge">{site.availability === 'waitlist' ? 'Recommended' : 'Most popular'}</span>
            )}
            <h3>{tier.name}</h3>
            <p class="price">{tier.price}</p>
            <p class="period">{tier.period} · {tier.devices}</p>
            {tier.yearly && (
              <p class="yearly">{tier.yearly.price} billed yearly — {tier.yearly.note}</p>
            )}
            <p class="blurb">{tier.blurb}</p>
            <ul>
              {tier.features.map((f) => <li>{f}</li>)}
            </ul>
            {site.availability === 'waitlist' ? (
              <a class:list={['btn', 'btn-block', tier.featured ? 'btn-primary' : 'btn-secondary']}
                 href="#waitlist">Get availability email</a>
            ) : (
              <a
                class:list={['btn', 'btn-block', tier.featured ? 'btn-primary' : 'btn-secondary']}
                href={tier.id === 'free' ? '#download' : (tier.checkoutMonthly || site.purchaseUrl || '#pricing')}
                aria-disabled={tier.id !== 'free' && !(tier.checkoutMonthly || site.purchaseUrl) ? 'true' : undefined}
                title={tier.id !== 'free' && !(tier.checkoutMonthly || site.purchaseUrl) ? 'Paid checkout is coming soon.' : undefined}
              >
                {tier.cta}
              </a>
            )}
          </div>
        ))}
      </div>
      {!site.purchaseUrl && (
        <p class="store-note">
          {site.availability === 'waitlist'
            ? 'Downloads are not available yet. The Free plan will be available when public downloads open; paid checkout is coming soon.'
            : 'The Free plan is available now. Paid checkout is coming soon.'}
        </p>
      )}
    </div>
  </section>

  <section class="band faq-band">
    <div class="container" style="text-align:center;">
      <h2 class="section-title">Questions, answered</h2>
      <div class="faq">
        <details>
          <summary>Does my recipient data go to GmailSmith?</summary>
          <p>Your campaign lists and history stay on your computer. The app
            sends each message through Google Gmail to the recipient you chose.
            Google Firebase Authentication processes your account email and
            display name for sign-in. We do not upload your campaign list to
            GmailSmith or use it for analytics. See the
            <a href="/privacy">Privacy Policy</a>.</p>
        </details>
        <details>
          <summary>Do I need to configure anything?</summary>
          <p>No. Sign in with Google in one click, or use a Gmail App Password
            if you prefer — either way you’re sending your first campaign in
            minutes.</p>
        </details>
        <details>
          <summary>What about Windows SmartScreen warnings?</summary>
          <p>The installer isn’t code-signed yet, so the warning is expected. <a
            href="/install">This page</a> shows the exact two clicks to
            proceed safely.</p>
        </details>
        <details>
          <summary>Is there really a free plan?</summary>
          <p>{site.availability === 'waitlist'
            ? 'The planned Free tier is $0 with a 25-email daily limit. Downloads are not available yet, and plan details may change before launch. Join the waitlist for one availability email.'
            : 'Yes — the full app, forever, at 25 emails a day. No credit card and no time limit.'}</p>
        </details>
        <details>
          <summary>Can I buy a paid plan today?</summary>
          <p>{site.availability === 'waitlist'
            ? 'No. Public downloads and paid checkout are not open yet. We do not have a release date yet.'
            : 'Paid checkout is not available yet. We will show the final plan, billing and cancellation details before checkout opens.'}</p>
        </details>
        {site.availability === 'waitlist' && (
          <details>
            <summary>What happens after I join?</summary>
            <p>We store your email for one availability notice. We will not send
              a newsletter or ongoing product marketing. You can request removal
              using the support email in the footer.</p>
          </details>
        )}
      </div>
    </div>
  </section>

  <style>
    .hero { text-align: center; max-width: 780px; }
    .eyebrow {
      color: var(--accent); text-transform: uppercase; letter-spacing: 0.12em;
      font-size: 12.5px; font-weight: 700; margin: 0 0 14px;
    }
    h1 {
      font-size: clamp(30px, 5.4vw, 52px); line-height: 1.12; margin: 0 0 18px;
      letter-spacing: -0.02em;
    }
    h1 em { color: var(--accent); font-style: normal; }
    .lede { color: var(--text-muted); font-size: 17px; margin: 0 auto 32px; max-width: 620px; }
    .download-row { display: flex; flex-direction: column; align-items: center; gap: 10px; }
    .btn-lg { padding: 15px 34px; font-size: 16.5px; }
    .download-meta { color: var(--text-dim); font-size: 13.5px; margin: 0; min-height: 20px; }
    .waitlist-card {
      max-width: 600px; margin: 0 auto; padding: 28px;
      background: var(--surface); border: 1px solid var(--border);
      border-radius: var(--radius); text-align: left;
    }
    .waitlist-card h2 { margin: 0 0 8px; font-size: 21px; text-align: center; }
    .waitlist-intro { color: var(--text-muted); font-size: 14.5px; text-align: center; margin: 0 0 20px; }
    .waitlist-form { display: grid; gap: 14px; }
    .field { display: grid; gap: 6px; }
    .field label { font-size: 14px; font-weight: 600; }
    .field input[type='email'] {
      width: 100%; border: 1px solid var(--border); border-radius: 9px;
      background: var(--bg); color: var(--text); font: inherit; padding: 12px 14px;
    }
    .field input:focus-visible, .consent-row input:focus-visible, .waitlist-form button:focus-visible {
      outline: 3px solid var(--accent); outline-offset: 3px;
    }
    .consent-row { display: flex; gap: 10px; align-items: flex-start; color: var(--text-muted); font-size: 13.5px; }
    .consent-row input { margin-top: 4px; width: 17px; height: 17px; flex: 0 0 auto; accent-color: var(--accent); }
    .turnstile-wrap { min-height: 65px; display: flex; justify-content: center; }
    .waitlist-form button { justify-self: center; }
    .waitlist-status { min-height: 22px; margin: 0; text-align: center; color: var(--text-muted); font-size: 14px; }
    .waitlist-status[data-state='error'] { color: #ff9b91; }
    .waitlist-status[data-state='success'] { color: var(--green); }
    .privacy-note, .waitlist-unavailable { margin: 0; color: var(--text-dim); font-size: 12.5px; text-align: center; }
    .honeypot { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
    @media (max-width: 560px) {
      .waitlist-card { padding: 20px 16px; }
      .waitlist-card h2 { font-size: 19px; }
      .waitlist-form .btn-lg { width: 100%; }
    }
    .smarthint {
      margin-top: 26px; font-size: 13.5px; color: var(--text-dim);
      max-width: 560px; margin-inline: auto;
    }
    .band { background: var(--surface); border-block: 1px solid var(--border); }
    .feature-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 32px; padding: 52px 24px;
    }
    .feature-grid h3 { margin: 0 0 8px; font-size: 17px; }
    .feature-grid p { margin: 0; color: var(--text-muted); font-size: 14.5px; }
    .google-data {
      background: var(--surface2); border-block: 1px solid var(--border);
      padding: 48px 24px;
    }
    .google-data p {
      color: var(--text-muted); font-size: 15px; line-height: 1.7;
      max-width: 800px; margin: 18px auto 0; text-align: center;
    }
    .section-title { text-align: center; font-size: clamp(24px, 3.4vw, 34px); margin: 0 0 8px; }
    .section-sub {
      text-align: center; color: var(--text-muted); max-width: 560px;
      margin: 0 auto 40px;
    }
    .pricing-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 22px; align-items: stretch;
    }
    .price-card {
      background: var(--surface2); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 26px 24px; position: relative;
      display: flex; flex-direction: column;
    }
    .price-card.featured { border-color: var(--accent); }
    .badge {
      position: absolute; top: -11px; left: 20px; background: var(--accent);
      color: var(--accent-ink); font-size: 11.5px; font-weight: 700;
      padding: 3px 10px; border-radius: 99px; text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    .price-card h3 { margin: 4px 0 2px; font-size: 17px; }
    .price { font-size: 38px; font-weight: 800; margin: 6px 0 0; }
    .period { color: var(--text-dim); font-size: 13px; margin: 2px 0; }
    .yearly { color: var(--accent); font-size: 13px; font-weight: 600; margin: 2px 0 12px; }
    .blurb { color: var(--text-muted); font-size: 14px; margin: 0 0 14px; }
    .price-card ul { margin: 0 0 20px; padding-left: 18px; color: var(--text-muted); font-size: 14px; }
    .price-card li { margin-bottom: 5px; }
    .btn-block { width: 100%; margin-top: auto; }
    .store-note {
      text-align: center; color: var(--text-dim); font-size: 13px;
      margin-top: 22px;
    }
    .store-note code { color: var(--text-muted); }
    .faq { max-width: 640px; margin: 26px auto 0; text-align: left; }
    .faq details {
      border: 1px solid var(--border); border-radius: 10px;
      padding: 14px 18px; margin-bottom: 12px; background: var(--surface2);
    }
    .faq summary { cursor: pointer; font-weight: 600; font-size: 15px; }
    .faq p { color: var(--text-muted); font-size: 14.5px; margin: 10px 0 0; }
  </style>

  {site.availability === 'waitlist' ? (
    <>
      {turnstileSiteKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
      <script define:vars={{ consentVersion: site.waitlistConsentVersion }}>
        const form = document.getElementById('waitlistForm');
        const status = document.getElementById('waitlistStatus');
        const submit = document.getElementById('waitlistSubmit');
        if (form && status && submit) {
          form.addEventListener('submit', async (event) => {
            event.preventDefault();
            if (!form.reportValidity()) return;
            const data = new FormData(form);
            const token = String(data.get('cf-turnstile-response') || '');
            if (!token) {
              status.textContent = 'Complete the security check, then try again.';
              status.dataset.state = 'error';
              return;
            }
            status.textContent = 'Saving your request…';
            status.dataset.state = '';
            submit.disabled = true;
            try {
              const response = await fetch('/api/waitlist', {
                method: 'POST',
                headers: { 'content-type': 'application/json' },
                body: JSON.stringify({
                  email: data.get('email'),
                  consent: data.get('consent') === 'on',
                  consentVersion,
                  turnstileToken: token,
                  company: data.get('company'),
                  source: new URLSearchParams(window.location.search).get('utm_source') || '',
                }),
              });
              const result = await response.json().catch(() => ({}));
              if (!response.ok || !result.ok) {
                throw new Error(result.message || 'We could not save your request. Please try again.');
              }
              status.textContent = result.message;
              status.dataset.state = 'success';
              form.reset();
              window.turnstile?.reset();
            } catch (error) {
              status.textContent = error instanceof Error
                ? error.message
                : 'We could not save your request. Please try again.';
              status.dataset.state = 'error';
              window.turnstile?.reset();
            } finally {
              submit.disabled = false;
            }
          });
        }
      </script>
    </>
  ) : (
    <script>
      // docs/08 §8.1: the manifest drives the button; never hard-code a build.
      fetch('/releases/latest.json')
        .then((r) => (r.ok ? r.json() : null))
        .then((release) => {
          const file = release && release.installer;
          if (!file) throw new Error('no installer in manifest');
          const btn = document.getElementById('downloadBtn');
          const meta = document.getElementById('downloadMeta');
          if (!btn || !meta) return;
          btn.href = '/releases/' + file.filename;
          btn.textContent = 'Download GmailSmith ' + release.version;
          meta.textContent =
            (file.bytes / 1048576).toFixed(1) +
            ' MB · SHA-256 ' + file.sha256.slice(0, 16) + '…';
        })
        .catch(() => {
          const meta = document.getElementById('downloadMeta');
          if (meta) {
            meta.textContent =
              'Release manifest unavailable — try again in a moment.';
          }
        });
    </script>
  )}
</Base>

