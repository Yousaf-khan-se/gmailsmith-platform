---
// Firebase action page for VERIFY_EMAIL and VERIFY_AND_CHANGE_EMAIL links.
import Base from '../layouts/Base.astro';
---

<Base title="Verify your email" path="/verify" noindex
      description="Verify your email address to finish setting up your GmailSmith account.">
  <article class="container doc">
    <h1>Verify your email</h1>
    <p id="verifyStatus" role="status">Checking the verification link…</p>
    <button id="confirmEmailChange" type="button" hidden>
      Confirm email change
    </button>
  </article>

  <style>
    .doc { max-width: 640px; padding: 72px 24px; }
    h1 { font-size: 30px; margin: 0 0 14px; }
    #verifyStatus { color: var(--text-muted); font-size: 15.5px; }
    #verifyStatus.ok { color: var(--green); font-weight: 600; }
    #verifyStatus.bad { color: #f87171; }
    #confirmEmailChange { margin-top: 16px; }
  </style>

  <script type="module">
    import { initializeApp } from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js';
    import { getAuth, applyActionCode, checkActionCode }
      from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js';
    import { firebaseWebConfig } from '../firebaseWebConfig';
    import { prepareVerifyAction } from '../lib/verifyAction.js';

    const status = document.getElementById('verifyStatus');
    const params = new URLSearchParams(window.location.search);
    const mode = params.get('mode');
    const oobCode = params.get('oobCode');

    async function verify() {
      const app = initializeApp(firebaseWebConfig);
      const auth = getAuth(app);
      const action = await prepareVerifyAction({
        mode,
        oobCode,
        auth,
        checkActionCode,
        applyActionCode,
      });
      if (action.kind === 'confirmation') {
        status.textContent = action.message;
        const button = document.getElementById('confirmEmailChange');
        button.hidden = false;
        button.addEventListener('click', async () => {
          button.disabled = true;
          try {
            status.textContent = await action.confirm();
            status.classList.remove('bad');
            status.classList.add('ok');
            button.hidden = true;
          } catch (err) {
            status.textContent = err.message || 'This link expired. Request another email change from GmailSmith.';
            status.classList.add('bad');
            button.disabled = false;
          }
        });
        return;
      }
      status.textContent = action.message;
      status.classList.add('ok');
    }

    verify().catch((err) => {
      status.textContent = err.message
        || 'That link no longer works — request a new verification email from the app.';
      status.classList.add('bad');
    });
  </script>
</Base>
